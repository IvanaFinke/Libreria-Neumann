@rendermode InteractiveServer

@inject IJSRuntime JS

<div class="footer">

    <div class="redes-seccion">

        <h5 class="frase"><strong>NUESTRAS REDES</strong></h5>

        <div class="iconos-redes">
            <a class="contenedor" href="https://www.instagram.com{@instagram}/" target="_blank">
                <i class="bi bi-instagram"></i>
            </a>

            <a class="contenedor-facebook" href="() => LinkFacebook()" target="_blank">
                <i class="bi bi-facebook"></i>
            </a>

            <a class="contenedor-tiktok" href="() => LinkTiktok()" target="_blank">
                <i class="bi bi-tiktok"></i>
            </a>
        </div>
       
    </div>

    <div class="clase-donde-estamos">

        <div class="clase-donde-estamos-pc">
            <h5 class="frase"><strong>DONDE ESTAMOS</strong></h5>

            <h5 class="ubicacion-frase">@calle, @altura, La Plata</h5>

            <div class="contenedor-link-horario">
                <div class="link-a-mapa">
                    <a href="https://maps.app.goo.gl/yEPUB2vcKns1oDeAA" target="_blank" class="icon-link">
                        <i class="bi bi-geo-alt-fill"></i> </a>
                </div>
                <h6 class="horario-texto">
                    Lun a Sab <br />@horaInicio a @horaSalida
                </h6>
            </div>
        </div>

        <div class="clase-donde-estamos-tablet">
            <h5 class="frase"><strong>DONDE ESTAMOS</strong></h5>
            <h5 class="ubicacion-frase">@calle,@altura, La Plata</h5>
            <div class="icono-horario">
                <div class="link-a-mapa"><i class="bi bi-geo-alt-fill"></i> </div>
                <h6 class="horario-texto-tablet"> Lun a Sab @horaInicio a @horaSalida</h6>
            </div>
        </div>

        <div id="map" class="map-shared"></div>
        
    </div>


    <div class="atencion-seccion">

        <h5 class="frase"><strong>ATENCIÓN</strong></h5>

            <div class="iconos-contacto">

                <div class="telefono-seccion">
                    <a class="contenedor" href="tel:@telefono"><i class="bi bi-telephone "></i></a>
                    <h6 class="frase-tel">@telefono</h6>
                </div>

                <div class="contenedor-mail">
                    <a href="mailto:libneum@gmail.com" class="icon-link"> <i class="bi bi-envelope"></i></a>
                    <h6 class="mail-texto">@mail</h6>
                </div>

                <div class="contenedor-ubicacion">
                    <NavLink >
                        <i class="bi bi-geo-alt-fill"></i>
                    </NavLink>
                    <h6 class="horario-texto">
                        Lun a Sab <br />@horaInicio a @horaSalida
                    </h6>
                </div>
            </div>
       
    </div>

    

</div>
@code {
    [Inject] private LibreriaService? libreriaService{ get; set; }
    private Libreria? libreria;
    private int? horaInicio, horaSalida,altura;
    private string? direccion,instagram,facebook,tiktok,mail,telefono,calle = "";

    protected override async Task OnInitializedAsync()
    {
        libreria = await libreriaService!.ObtenerLibreria();
        if(libreria != null)
        {
            horaInicio = libreria.HoraInicio;
            horaSalida = libreria.HoraSalida;
            altura = libreria.AlturaCalle;
            direccion = libreria.Calle;
            instagram = libreria.Instagram;
            facebook = libreria.Facebook;
            tiktok = libreria.Tiktok;
            mail = libreria.Email;
            telefono = libreria.Telefono;
            calle = libreria.Calle;
        }
    }

    private string LinkInsta() => $"https://www.instagram.com{instagram}/";
    private string LinkTiktok() => $"https://www.tiktok.com{@tiktok}";
    private string LinkFacebook() => $"https://www.facebook.com/{@facebook}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initMap", "map", -34.921819, -57.963100);
        }
    }
}
